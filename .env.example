# Aucune valeur réelle. Copier vers .env (gitignoré) si une base locale est utilisée.
# Lancement de démonstration (données fictives) :
#   DC_EDU_DEMO=1 DC_EDU_AUTH=0 python -c "from d3dash.app import creer_app_production as c; c().server.run(host='127.0.0.1', port=8796)"
DC_EDU_DEMO=1
DC_EDU_AUTH=0
DC_EDU_PG_HOST=127.0.0.1
DC_EDU_PG_PORT=5432
DC_EDU_PG_DB=data_challenge_edu
DC_EDU_PG_USER=
DC_EDU_PG_PASSWORD=
DC_EDU_CODE_HASH=
DC_EDU_SECRET_KEY=
# Second code d'accès (jury), facultatif : vide = fonction inactive.
DC_EDU_CODE_HASH_JURY=
# Proxys inverses dont X-Forwarded-For est cru (liste séparée par des virgules). Vide = aucun,
# l'en-tête est ignoré. nginx écrase cet en-tête avec l'adresse du client ; en local, laisser vide.
DC_EDU_PROXYS_CONFIANCE=
# 1 uniquement derrière HTTPS : en local (http://127.0.0.1) le cookie Secure rendrait la session inutilisable.
DC_EDU_COOKIE_SECURE=0
